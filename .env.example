# Copy to .env and fill in the values you need.
# The framework runs fully offline with zero keys set (heuristic scoring);
# add these to enable LLM-as-judge scoring and optional integrations.

# --- LLM judge (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_JUDGE_PROVIDER=heuristic   # heuristic | openai | anthropic
LLM_JUDGE_MODEL=gpt-4o-mini

# --- Integrations (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-evaluation-framework
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=llm-evaluation-framework

# --- Pipeline ---
EVAL_CONFIG_PATH=src/config/eval_config.yaml
REPORT_OUTPUT_DIR=reports

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
